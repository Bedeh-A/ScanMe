# Public PostHog browser configuration.
VITE_PUBLIC_POSTHOG_KEY=phc_your_public_project_token
VITE_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Public key for the Scanme missed-barcode Turnstile widget.
VITE_PUBLIC_TURNSTILE_SITE_KEY=

# Optional release label stored with reports (never user or image data).
VITE_APP_VERSION=development
